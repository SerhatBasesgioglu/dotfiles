    { "action": "shell", "resource": "argocd proj list *", "effect": "allow" },
    { "action": "shell", "resource": "argocd proj get *", "effect": "allow" },
    { "action": "shell", "resource": "argocd app sync *", "effect": "ask" },
    { "action": "shell", "resource": "argocd app rollback *", "effect": "ask" },
    { "action": "shell", "resource": "argocd app set *", "effect": "ask" },
    { "action": "shell", "resource": "argocd app terminate-op *", "effect": "ask" },
    { "action": "shell", "resource": "argocd app actions run *", "effect": "ask" },
    { "action": "shell", "resource": "az pipelines *", "effect": "ask" },
    { "action": "shell", "resource": "az pipelines list *", "effect": "allow" },
    { "action": "shell", "resource": "az pipelines show *", "effect": "allow" },
    { "action": "shell", "resource": "az pipelines runs list *", "effect": "allow" },
    { "action": "shell", "resource": "az pipelines runs show *", "effect": "allow" },
    { "action": "shell", "resource": "az * pipelines list *", "effect": "allow" },
    { "action": "shell", "resource": "az * pipelines show *", "effect": "allow" },
    { "action": "shell", "resource": "az * pipelines runs list *", "effect": "allow" },
    { "action": "shell", "resource": "az * pipelines runs show *", "effect": "allow" },
    { "action": "shell", "resource": "az pipelines run *", "effect": "ask" },
    { "action": "shell", "resource": "az * pipelines run *", "effect": "ask" },
    { "action": "shell", "resource": "az pipelines runs cancel *", "effect": "ask" },
    { "action": "shell", "resource": "az * pipelines runs cancel *", "effect": "ask" },
    { "action": "shell", "resource": "az pipelines variable create *", "effect": "ask" },
    { "action": "shell", "resource": "az pipelines variable update *", "effect": "ask" },
    { "action": "shell", "resource": "az pipelines variable delete *", "effect": "ask" }
  ],
  "providers": {
    "9router": {
      "name": "9router",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "sol": {
          "modelID": "cx/gpt-5.6-sol",
          "name": "GPT-5.6 Sol",
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "minimal", "settings": { "reasoningEffort": "minimal" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "terra": {
          "modelID": "cx/gpt-5.6-terra",
          "name": "GPT-5.6 Terra",
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "minimal", "settings": { "reasoningEffort": "minimal" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "luna": {
          "modelID": "cx/gpt-5.6-luna",
          "name": "GPT-5.6 Luna",
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "minimal", "settings": { "reasoningEffort": "minimal" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "codex": {
          "modelID": "gh/gpt-5.3-codex",
          "name": "GPT-5.3 Codex",
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "minimal", "settings": { "reasoningEffort": "minimal" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "qwen35": {
          "modelID": "vakif/qwen35",
          "name": "Qwen 3.5 122B",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              },
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                }
              }
            }
          ]
        }
      }
    }
  },
  "plugins": [
    "./plugins/ops-brain-v2",
    "./plugins/subagent-schema-fix"
  ],
  "plugin": [
    "oh-my-opencode-slim@2.2.22"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}

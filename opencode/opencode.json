{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/terra",
  "default_agent": "build",
  "experimental": {
    "subagent_depth": 2
  },
  "providers": {
    "9router": {
      "name": "9router",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "sol": {
          "modelID": "cx/gpt-5.6-sol",
          "name": "GPT-5.6 Sol"
        },
        "terra": {
          "modelID": "cx/gpt-5.6-terra",
          "name": "GPT-5.6 Terra"
        },
        "luna": {
          "modelID": "cx/gpt-5.6-luna",
          "name": "GPT-5.6 Luna"
        },
        "codex": {
          "modelID": "gh/gpt-5.3-codex",
          "name": "GPT-5.3 Codex"
        },
        "qwen35": {
          "modelID": "vakif/qwen35",
          "name": "Qwen 3.5 122B",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/sol",
  "default_agent": "orchestrator",
  "experimental": {
    "subagent_depth": 2
  },
  "providers": {
    "9router": {
      "name": "9router",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "sol": {
          "modelID": "cx/gpt-5.6-sol",
          "name": "GPT-5.6 Sol"
        },
        "terra": {
          "modelID": "cx/gpt-5.6-terra",
          "name": "GPT-5.6 Terra"
        },
        "luna": {
          "modelID": "cx/gpt-5.6-luna",
          "name": "GPT-5.6 Luna"
        },
        "codex": {
          "modelID": "gh/gpt-5.3-codex",
          "name": "GPT-5.3 Codex"
        },
        "qwen35": {
          "modelID": "vakif/qwen35",
          "name": "Qwen 3.5 122B",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/Users/vb41454/repos/vault/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/Users/vb41454/repos/vault/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/Users/vb41454/repos/vault/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    }
  ],
  "lsp": true
}

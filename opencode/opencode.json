    { "action": "shell", "resource": "kubectl replace *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * replace *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl rollout *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * rollout *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl scale *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * scale *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl set *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * set *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl cp *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * cp *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl debug *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * debug *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl port-forward *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * port-forward *", "effect": "ask" },
    { "action": "shell", "resource": "helm *", "effect": "ask" },
    { "action": "shell", "resource": "helm list *", "effect": "allow" },
    { "action": "shell", "resource": "helm status *", "effect": "allow" },
    { "action": "shell", "resource": "helm history *", "effect": "allow" },
    { "action": "shell", "resource": "helm get *", "effect": "allow" },
    { "action": "shell", "resource": "helm * list *", "effect": "allow" },
    { "action": "shell", "resource": "helm * status *", "effect": "allow" },
    { "action": "shell", "resource": "helm * history *", "effect": "allow" },
    { "action": "shell", "resource": "helm * get *", "effect": "allow" },
    { "action": "shell", "resource": "helm install *", "effect": "ask" },
    { "action": "shell", "resource": "helm * install *", "effect": "ask" },
    { "action": "shell", "resource": "helm upgrade *", "effect": "ask" },
    { "action": "shell", "resource": "helm * upgrade *", "effect": "ask" },
    { "action": "shell", "resource": "helm rollback *", "effect": "ask" },
    { "action": "shell", "resource": "helm * rollback *", "effect": "ask" },
    { "action": "shell", "resource": "helm uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "helm * uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "helm test *", "effect": "ask" },
    { "action": "shell", "resource": "helm * test *", "effect": "ask" },
    { "action": "shell", "resource": "argocd *", "effect": "ask" },
    { "action": "shell", "resource": "argocd app list *", "effect": "allow" },
    { "action": "shell", "resource": "argocd app get *", "effect": "allow" },
    { "action": "shell", "resource": "argocd app history *", "effect": "allow" },
    { "action": "shell", "resource": "argocd app logs *", "effect": "allow" },
    { "action": "shell", "resource": "argocd app manifests *", "effect": "allow" },
    { "action": "shell", "resource": "argocd app diff *", "effect": "allow" },
